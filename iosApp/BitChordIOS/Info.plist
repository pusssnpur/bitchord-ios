    <string>BitChord needs access to your music library for local file playback</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>BitChord uses microphone for audio visualization features</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>BitChord uses Bluetooth for audio output to wireless headphones</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>BitChord uses local network for Listen Together party sync and WebDAV</string>
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>UISupportsDocumentBrowser</key>
    <true/>
